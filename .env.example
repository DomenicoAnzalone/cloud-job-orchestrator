# Cloud Job Orchestrator - environment variables template
# Copy needed values into your local environment or backend/local.settings.json.

# =========================
# Backend (Azure Functions)
# =========================
# Azure Functions runtime language worker.
FUNCTIONS_WORKER_RUNTIME=python
# Storage account connection string used by Azure Functions runtime and triggers.
AzureWebJobsStorage=UseDevelopmentStorage=true
# Service Bus connection string used by JobsWorker trigger and enqueue operations.
SERVICEBUS_CONNECTION=Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=<key_name>;SharedAccessKey=<key_value>
# Queue name for job dispatch (defaults to q-jobs in code).
SERVICEBUS_JOBS_QUEUE=q-jobs
# Cosmos DB account endpoint URL.
COSMOS_ENDPOINT=https://<cosmos-account>.documents.azure.com:443/
# Cosmos DB primary/secondary key.
COSMOS_KEY=<cosmos-key>
# Cosmos DB database name (defaults to cjo in code).
COSMOS_DB=cjo
# Cosmos DB container name (defaults to jobs in code).
COSMOS_CONTAINER=jobs
# Blob storage connection string for input/output uploads.
BLOB_CONNECTION=DefaultEndpointsProtocol=https;AccountName=<storage-account>;AccountKey=<account-key>;EndpointSuffix=core.windows.net
# Blob output container name (defaults to output in code).
BLOB_OUTPUT_CONTAINER=output
# Blob account URL used for user-delegation SAS generation.
BLOB_ACCOUNT_URL=https://<storage-account>.blob.core.windows.net
# Download link expiration in minutes (defaults to 10 in code).
OUTPUT_LINK_TTL_MINUTES=10
# SignalR Service connection string used for negotiate and publish.
SIGNALR_CONNECTION_STRING=Endpoint=https://<signalr-name>.service.signalr.net;AccessKey=<signalr-key>;Version=1.0;
# SignalR hub name used for realtime job events (defaults to jobs in code).
SIGNALR_HUB_NAME=jobs
# Optional artificial worker delay in seconds for demo UX (defaults to 0).
WORKER_DELAY_SECONDS=0

# =========================
# Frontend
# =========================
# Public API base URL consumed by frontend when loaded from settings files.
FRONTEND_API_BASE_URL=http://localhost:7071/api
# Backward-compatible aliases also read by frontend code.
API_BASE_URL=http://localhost:7071/api
CJO_API_BASE_URL=http://localhost:7071/api
# Local static server port for frontend/server.js.
PORT=3000

# =========================
# Azure services (resource identifiers)
# =========================
# Azure AD tenant used by frontend/backend auth checks.
AZURE_AD_TENANT_ID=<tenant-guid>
# Azure AD app registration client ID used by frontend MSAL login.
AZURE_AD_CLIENT_ID=<client-guid>
# Backend application ID URI (audience) used for access token scope validation.
AZURE_AD_API_AUDIENCE=api://<api-app-id>
